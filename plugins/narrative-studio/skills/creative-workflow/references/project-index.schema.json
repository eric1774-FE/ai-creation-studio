{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-project/v1",
  "title": "Creative Project Index",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "title",
    "project_type",
    "created_at",
    "updated_at",
    "visual_style",
    "sources",
    "stages",
    "approvals"
  ],
  "properties": {
    "schema_version": { "const": "creative-project/v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "project_type": { "enum": ["short_drama", "manhua", "picture_book", "other"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "visual_style": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["profile_id", "name", "source", "description", "confirmed_at"],
          "properties": {
            "profile_id": { "type": "string" },
            "name": { "type": "string" },
            "source": { "enum": ["preset", "custom", "reference"] },
            "description": { "type": "string" },
            "reference_paths": { "type": "array", "items": { "type": "string" } },
            "confirmed_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      ]
    },
    "sources": { "type": "array", "items": { "type": "object" } },
    "stages": { "type": "object", "additionalProperties": { "type": "object" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "provenance_policy": { "type": "object" }
  },
  "additionalProperties": true
}
