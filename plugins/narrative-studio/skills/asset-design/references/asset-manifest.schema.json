{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-assets/v1",
  "title": "Creative Asset Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "visual_style", "assets"],
  "properties": {
    "schema_version": { "const": "creative-assets/v1" },
    "project_id": { "type": "string" },
    "visual_style": { "type": ["object", "null"] },
    "reference_inputs": { "type": "array", "items": { "type": "object", "required": ["id", "path", "role", "allowed_influence", "forbidden_influence"] } },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "stable_facts", "versions", "source_refs"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["character", "costume", "hair", "makeup", "location", "prop", "vehicle", "creature", "environment", "lighting", "effect", "sound"] },
          "name": { "type": "string" },
          "stable_facts": { "type": "array", "items": { "type": "object", "required": ["fact", "origin", "status"] } },
          "versions": { "type": "array", "items": { "type": "object", "required": ["version", "state", "prompt_zh", "prompt_en"] } },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "related_asset_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
