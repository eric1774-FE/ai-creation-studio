{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-storyboard/v1",
  "title": "Creative Storyboard",
  "type": "object",
  "required": ["schema_version", "project_id", "source_refs", "shots"],
  "properties": {
    "schema_version": { "const": "creative-storyboard/v1" },
    "project_id": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "format": { "type": "object", "properties": { "aspect_ratio": { "type": "string" }, "target_duration_seconds": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": true },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "scene", "story_beat", "action", "framing", "duration_seconds", "continuity_refs"],
        "properties": {
          "shot_id": { "type": "string" },
          "scene": { "type": "string" },
          "story_beat": { "type": "string" },
          "action": { "type": "object", "required": ["start_state", "movement", "result"] },
          "framing": { "type": "string" },
          "camera": { "type": "string" },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "sound": { "type": "string" },
          "continuity_refs": { "type": "array", "items": { "type": "string" } },
          "prompt_generic": { "type": "string" },
          "prompt_seedance_2": { "type": "string" },
          "review_notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
